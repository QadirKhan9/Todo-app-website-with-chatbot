# Environment variables for Todo App Frontend

# Backend API URL
# For local development (backend runs on port 8000 as per your setup)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# For Vercel deployment with Hugging Face backend, this should be updated to your actual backend URL
NEXT_PUBLIC_API_BASE_URL=https://qadirk-todo-app-website.hf.space

# Note: API version prefix (/api/v1) is included in the individual endpoint paths, not in the base URL