# Database settings
DATABASE_URL=postgresql://user:password@localhost:5432/todo_db
DATABASE_ECHO=False

# Cohere settings
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL="gemini-2.5-flash"
# JWT settings
SECRET_KEY=your_jwt_secret_key_here
